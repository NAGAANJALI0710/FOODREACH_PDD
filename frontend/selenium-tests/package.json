{
  "name": "foodreach-selenium-tests",
  "version": "2.0.0",
  "description": "Selenium E2E tests (420+ TCs) for FoodReach AI Platform — with Excel + HTML reporting",
  "main": "run-all.js",
  "scripts": {
    "test":          "node run-all.js",
    "all":           "node run-all.js",
    "report:excel":  "node reporter/excelReporter.js all",
    "report:html":   "node reporter/htmlReporter.js",
    "login":         "mocha tests/login.test.js --timeout 30000 --reporter json",
    "register":      "mocha tests/register.test.js --timeout 30000 --reporter json",
    "donor":         "mocha tests/donor.test.js --timeout 60000 --reporter json",
    "ngo":           "mocha tests/ngo.test.js --timeout 60000 --reporter json",
    "volunteer":     "mocha tests/volunteer.test.js --timeout 60000 --reporter json",
    "admin":         "mocha tests/admin.test.js --timeout 60000 --reporter json",
    "notifications": "mocha tests/notifications.test.js --timeout 30000 --reporter json",
    "profile":       "mocha tests/profile.test.js --timeout 30000 --reporter json",
    "maps":          "mocha tests/maps.test.js --timeout 30000 --reporter json",
    "security":      "mocha tests/security.test.js --timeout 30000 --reporter json"
  },
  "dependencies": {
    "exceljs":            "^4.4.0",
    "fs-extra":           "^11.2.0",
    "mocha":              "^10.4.0",
    "selenium-webdriver": "^4.20.0",
    "chromedriver":       "^124.0.1",
    "chalk":              "^4.1.2",
    "dayjs":              "^1.11.11"
  },
  "devDependencies": {
    "@types/mocha":              "^10.0.6",
    "@types/selenium-webdriver": "^4.1.26"
  }
}
